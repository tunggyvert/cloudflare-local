{
  "name": "cloudflare-local",
  "version": "0.0.1",
  "description": "A local-first manager for Cloudflare Tunnels and their origins",
  "private": true,
  "license": "MIT",
  "author": "tunggyvert",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "node scripts/check-core-isolation.mjs && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/test-docker-labels.mjs && node scripts/test-cache-store.mjs",
    "package": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "check:core": "node scripts/check-core-isolation.mjs"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "cloudflare": "^7.1.0",
    "dockerode": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dockerode": "^3.3.31",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  },
  "type": "module"
}
